generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model TicketCategories {
  name         String
  description  String?
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  categoryCode TicketCategoryCode @id @unique
  ticketTypes  EventTicketTypes[]

  @@map("TicketCategories")
}

model Partner {
  id          String          @id @default(uuid())
  cognitoId   String          @unique
  email       String          @unique
  name        String
  companyName String
  phone       String
  address     String?
  isVerified  Boolean         @default(false)
  isActive    Boolean         @default(true)
  commission  Float           @default(10.0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  events      Event[]
  members     PartnerMember[]
  venues      Venue[]
  addresses   EventVenues[]

  @@index([cognitoId])
  @@index([email])
  @@map("partnerProfiles")
}

/// Partner-portal staff (2M MAU can map here without 2M Partner rows)
model PartnerMember {
  id        String   @id @default(uuid())
  partnerId String
  cognitoId String   @unique
  email     String
  name      String?
  role      String   @default("STAFF")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  partner   Partner  @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
  @@index([cognitoId])
}

model Venue {
  id          String    @id @default(uuid())
  partnerId   String
  name        String
  address     String
  city        String
  state       String
  zipCode     String
  capacity    Int
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  venueType   VenueType @default(CLUB)
  metadata    Json      @default("{}")
  events      Event[]
  partner     Partner   @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
  @@index([city])
  @@index([venueType])
}

model Event {
  id               String       @id @default(uuid())
  partnerId        String
  name             String
  category         String
  description      String?
  backgroundImage  String?
  eventDate        DateTime
  startTime        String
  endTime          String?
  venueName        String
  location         String
  ticketSalesClose DateTime?
  noteToAttendees  String?
  termsConditions  String?
  refundPolicy     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  venueId          String?
  eventType        EventType    @default(CLUB_NIGHT)
  eventStatus      Int          @default(0) // 0: DRAFT, 1: PUBLISHED, 2: CANCELLED
  metadata         Json         @default("{}")
  publishedAt      DateTime?
  city             String?
  state            String?
  zipCode          String?
  latitude         Float?
  longitude        Float?
  addressId        String?
  partner          Partner      @relation(fields: [partnerId], references: [id])
  venue            Venue?       @relation(fields: [venueId], references: [id])
  ticketTypes      EventTicketTypes[]

  @@index([partnerId])
  @@index([venueId])
  @@index([category])
  @@index([eventStatus])
  @@index([eventDate])
}

model EventTicketTypes {
  id           String             @id @default(uuid())
  eventId      String
  name         String?
  price        Float
  quantity     Int
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  categoryCode TicketCategoryCode
  category     TicketCategories     @relation(fields: [categoryCode], references: [categoryCode])
  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([categoryCode])
  @@map("EventTicketTypes")
}

enum VenueType {
  CLUB
  ARENA
  CORPORATE_HALL
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum EventType {
  CLUB_NIGHT
  SPORTS
  CORPORATE
  PRIVATE
  OTHER
}

enum TicketCategoryCode {
  EBD
  PH2
  PH3
  PH4
  LSL
  CUP
  GRL
  STD
  GR4
  PL4
  LGR
}

model EventVenues {
  id                String   @id @default(uuid())
  partnerId         String
  customAddressName String
  addressLine1      String
  addressLine2      String?
  city              String
  state             String
  zipCode           String
  country           String   @default("IN")
  latitude          Float?
  longitude         Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  partner           Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("EventVenues")
}

model EventCategories {
  code        String   @id @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("EventCategories")
}
