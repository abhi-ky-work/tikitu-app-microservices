# AWS Cognito
AWS_REGION=us-east-1
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=

# Service-to-service auth
INTERNAL_API_KEY=tikitu-dev-internal-key

# Redis
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# Service URLs (local dev)
ADMIN_SERVICE_URL=http://localhost:3001
PARTNER_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3004
BOOKING_SERVICE_URL=http://localhost:3005
USER_SERVICE_URL=http://localhost:3006

# Databases
ADMIN_DATABASE_URL=postgresql://tikitu:tikitu_password@localhost:5432/admin_db
PARTNER_DATABASE_URL=postgresql://tikitu:tikitu_password@localhost:5432/partner_db
PAYMENT_DATABASE_URL=postgresql://tikitu:tikitu_password@localhost:5432/payment_db
NOTIFICATION_DATABASE_URL=postgresql://tikitu:tikitu_password@localhost:5432/notification_db
BOOKING_DATABASE_URL=postgresql://tikitu:tikitu_password@localhost:5432/booking_db
USER_DATABASE_URL=postgresql://tikitu:tikitu_password@localhost:5432/user_db

# Optional read replicas (defaults to primary in dev)
BOOKING_DATABASE_READ_URL=
USER_DATABASE_READ_URL=

# OpenSearch (optional)
OPENSEARCH_URL=

# Rate limiting
BOOKING_RATE_LIMIT_PER_MINUTE=30
EVENTS_CACHE_TTL_SECONDS=60
